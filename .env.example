# Postgres (docker-compose maps container 5432 -> host 5433 to avoid clashing
# with the original compliance-agent project's DB on 5432)
DATABASE_URL=postgresql+psycopg2://meetingcompliance:meetingcompliance@127.0.0.1:5433/meeting_compliance

# --- Auth ---
# Demo login and real "Sign in with Microsoft" are independent and can both
# be available at once. Demo login is instant sign-in as one of 3 fixed
# demo accounts (app/directory.py) — set to false to hide it in a real
# deployment (it can never be used to sign in as a real person either way).
ENABLE_DEMO_LOGIN=true
SESSION_SECRET=change-me-to-a-random-string

# Fill these in to turn on real "Sign in with Microsoft". Register an app
# in Azure AD (see HELPDESK_EMAIL_DRAFT.md) and fill these in.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8010/auth/callback

# --- Organization time zone ---
# Punch times are always stored in UTC. The organization time zone decides
# how every time is shown (UI and assistant) and which calendar day a punch
# counts for. Pick it on the Settings page; this value is only used until
# someone saves a zone there. Must be an IANA name such as Asia/Kolkata,
# Europe/London or America/New_York (an unknown name falls back to UTC).
DEFAULT_TIMEZONE=UTC

# --- Chat assistant ---
# LangChain agent on Groq. Get a key at https://console.groq.com/keys.
# Without it, POST /chat returns a clear 503 ("GROQ_API_KEY is not set")
# instead of failing obscurely.
GROQ_API_KEY=
# Any Groq model with tool calling. Groq retires models from time to time
# (llama-3.1-8b-instant and llama-3.3-70b-versatile are gone); list the ones
# your key can use at https://console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss only: low | medium | high. Reasoning tokens count against Groq's
# tokens-per-minute limit (8k/min on the free tier), so keep it low.
GROQ_REASONING_EFFORT=low

# Semantic search over attendance records (HuggingFace embeddings).
# "api" = HuggingFace Inference API (needs the token below);
# "local" = run the model on this machine: pip install '.[local-embeddings]'
EMBEDDINGS_MODE=api
# https://huggingface.co/settings/tokens — a fine-grained token with the
# "Make calls to Inference Providers" permission. HF_TOKEN works too.
# Without it the chatbot still works (exact SQL-backed attendance tools),
# only semantic search is disabled.
HUGGINGFACEHUB_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: pin an inference provider (e.g. hf-inference); empty = HF's default.
HF_INFERENCE_PROVIDER=
# Per-day attendance records from the last N days are embedded for search.
ASSISTANT_INDEX_DAYS=120

# --- Compliance engine (app/compliance/) ---
# Comma-separated e-mails that are always Super Admins, so a fresh install has
# someone who can set up roles and access. Replace the demo default with your
# own administrators in a real deployment.
COMPLIANCE_SUPER_ADMINS=ava.martinez@corp.com
# Where evidence uploads are stored (a volume in Docker) and the size limit.
EVIDENCE_DIR=data/evidence
EVIDENCE_MAX_MB=10
# How often deadlines and escalations are re-checked, in minutes (0 = off).
COMPLIANCE_TICK_MINUTES=5
