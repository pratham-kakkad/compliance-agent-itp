# Postgres (docker-compose maps container 5432 -> host 5433 to avoid clashing
# with the original compliance-agent project's DB on 5432)
DATABASE_URL=postgresql+psycopg2://meetingcompliance:meetingcompliance@127.0.0.1:5433/meeting_compliance

# --- Auth ---
# "dev": instant login as any stub directory user, no external dependency.
# "microsoft": real "Sign in with Microsoft" (Azure AD app registration required).
AUTH_MODE=dev
SESSION_SECRET=change-me-to-a-random-string

# Only required when AUTH_MODE=microsoft. Register an app in Azure AD (see
# HELPDESK_EMAIL_DRAFT.md) and fill these in.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8010/auth/callback

# --- Chat assistant ---
# Needed for the "Ask about your meetings" copilot. Without it the /chat
# endpoint returns a clear 503 instead of failing obscurely.
ANTHROPIC_API_KEY=
