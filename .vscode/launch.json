{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Attach to Meeting Compliance app",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/app",
          "remoteRoot": "/app/app"
        }
      ],
      "justMyCode": true,
      "preLaunchTask": "docker-debug-up"
    }
  ]
}
